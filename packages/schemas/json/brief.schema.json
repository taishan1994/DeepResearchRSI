{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepresearchrsi/schemas/brief.schema.json",
  "title": "ResearchBrief",
  "type": "object",
  "required": ["question", "as_of", "deliverable", "subquestions"],
  "additionalProperties": false,
  "properties": {
    "question": { "type": "string", "minLength": 8 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topic": { "type": "string" },
        "region": { "type": "string" },
        "language": { "type": "string" },
        "time_range": { "type": "string" }
      }
    },
    "as_of": { "type": "string", "format": "date" },
    "freshness": { "enum": ["realtime", "30d", "historical"] },
    "deliverable": {
      "enum": ["comparison", "progress_table", "roadmap", "tracking_report", "deep_analysis"]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_priority": { "type": "array", "items": { "type": "string" } },
        "citation_style": { "type": "string" },
        "depth": { "enum": ["shallow", "standard", "deep"] },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_tool_calls": { "type": "integer", "minimum": 1 },
            "max_minutes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "subquestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "done_when"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^q[0-9]+$" },
          "question": { "type": "string" },
          "expected_evidence": { "type": "string" },
          "done_when": { "type": "string" },
          "status": { "enum": ["answered", "partial", "unanswered"] }
        }
      }
    }
  }
}
