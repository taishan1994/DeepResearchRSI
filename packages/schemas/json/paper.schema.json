{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepresearchrsi.local/schemas/paper.schema.json",
  "title": "Paper",
  "description": "一篇从研究档案生成的综述论文。Paper 不新增事实，只对 research/<slug>/ 下已有的 Claim 做选择、排序与呈现；每个数据点都必须能回溯到 claim_id。",
  "type": "object",
  "required": ["paper_id", "slug", "title", "abstract", "sections", "figures", "tables"],
  "additionalProperties": false,
  "properties": {
    "paper_id": {
      "type": "string",
      "pattern": "^paper-[a-z0-9][a-z0-9-]*$"
    },
    "slug": {
      "type": "string",
      "description": "指向 research/<slug>/，论文的数据来源",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": ["string", "null"] },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "language": { "type": "string", "enum": ["zh", "en"] },
    "abstract": { "type": "string", "minLength": 1 },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section_id", "number", "title"],
        "additionalProperties": false,
        "properties": {
          "section_id": { "type": "string", "pattern": "^s[0-9]+$" },
          "number": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "file": {
            "type": "string",
            "description": "相对 paper 目录的正文章节文件；为空表示该节内联在 main.md"
          },
          "cites": {
            "type": "array",
            "items": { "type": "string", "pattern": "^c-[A-Za-z0-9_-]+$" }
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["figure_id", "kind", "title", "cites"],
        "additionalProperties": false,
        "properties": {
          "figure_id": { "type": "string", "pattern": "^fig-[0-9]+$" },
          "kind": {
            "type": "string",
            "enum": ["bar", "grouped-bar", "scatter", "line", "box", "heatmap", "matrix-table"]
          },
          "title": { "type": "string", "minLength": 1 },
          "caption": { "type": "string" },
          "cites": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^c-[A-Za-z0-9_-]+$" }
          },
          "data_file": {
            "type": "string",
            "description": "figures/<name>.csv；每行一个数据点，列名由 kind 决定"
          },
          "output": { "type": "string", "description": "figures/<name>.png" },
          "notes": { "type": "string" }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table_id", "title", "cites"],
        "additionalProperties": false,
        "properties": {
          "table_id": { "type": "string", "pattern": "^tab-[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "caption": { "type": "string" },
          "cites": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^c-[A-Za-z0-9_-]+$" }
          },
          "data_file": { "type": "string" }
        }
      }
    }
  }
}
