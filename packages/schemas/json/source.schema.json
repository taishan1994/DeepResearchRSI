{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepresearchrsi/schemas/source.schema.json",
  "title": "Source",
  "type": "object",
  "required": ["source_id", "url", "source_type", "trust_tier", "fetched_at"],
  "additionalProperties": false,
  "properties": {
    "source_id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
    "url": { "type": "string", "format": "uri" },
    "doi": { "type": "string" },
    "source_type": {
      "enum": ["official", "vendor", "review", "academic", "community", "press", "retail"]
    },
    "publisher": { "type": "string" },
    "title": { "type": "string" },
    "published_at": { "type": ["string", "null"], "format": "date" },
    "updated_at": { "type": ["string", "null"], "format": "date" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "language": { "type": "string" },
    "trust_tier": { "enum": ["primary", "secondary", "tertiary"] },
    "access": { "enum": ["open", "paywalled", "blocked", "login_required"] },
    "license": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
