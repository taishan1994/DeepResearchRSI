{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepresearchrsi/schemas/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "required": [
    "claim_id",
    "statement",
    "claim_type",
    "as_of",
    "confidence",
    "evidence_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^c-[a-z0-9-]+$"
    },
    "statement": {
      "type": "string",
      "minLength": 5
    },
    "claim_type": {
      "enum": [
        "spec",
        "measurement",
        "price",
        "attribution",
        "prediction"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "disputed"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^e-[a-z0-9-]+$"
      }
    },
    "counter_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^e-[a-z0-9-]+$"
      }
    },
    "derivation": {
      "type": "string",
      "description": "Required when the statement is a system inference rather than a source fact."
    },
    "notes": {
      "type": "string"
    },
    "sku": {
      "type": "string",
      "enum": [
        "na",
        "all",
        "unspecified",
        "ws",
        "mq",
        "se",
        "mq+ws",
        "se+ws",
        "mq+se",
        "mq+se+ws"
      ],
      "default": "na",
      "description": "RTX PRO 6000 的 SKU。ws=Workstation Edition(600W)、mq=Max-Q(300W)、se=Server Edition、all=三个都适用、na=与该型号的 SKU 无关、unspecified=来源未写明（欠账状态）。比较型主张用 + 连接，按字母序。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "prediction"
          }
        }
      },
      "then": {
        "required": [
          "derivation"
        ]
      }
    }
  ]
}
