{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepresearchrsi/schemas/run.schema.json",
  "title": "ResearchRun",
  "description": "一次研究运行的完整记录。是阶段 1 验收门槛「轨迹可看」的载体。",
  "type": "object",
  "required": ["run_id", "as_of", "stop_reason", "budget", "trace"],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^run-[a-z0-9][a-z0-9-]*$",
      "description": "稳定 ID，如 run-rtx-pro-6000-2026-10"
    },
    "slug": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "as_of": {
      "type": "string",
      "format": "date",
      "description": "信息截止时点，须与 brief.yaml 的 as_of 一致"
    },
    "plan_version": { "type": "integer", "minimum": 1 },
    "report_version": { "type": "integer", "minimum": 1 },
    "stop_reason": {
      "enum": ["answered", "budget_exhausted", "gap_remaining", "error"],
      "description": "不变量 R1：必填。budget_exhausted / gap_remaining 时必须同时给出未解决问题。"
    },
    "stop_note": {
      "type": "string",
      "description": "stop_reason 的自然语言说明；gap_remaining 时列出剩余缺口"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limits"],
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_tool_calls": { "type": "integer", "minimum": 1 },
            "max_minutes": { "type": "integer", "minimum": 1 }
          }
        },
        "used": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool_calls": { "type": "integer", "minimum": 0 },
            "minutes": { "type": "number", "minimum": 0 },
            "sources_fetched": { "type": "integer", "minimum": 0 },
            "fetch_failures": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "trace": {
      "type": "array",
      "description": "结构化事件序列。每条记录一次可观察的动作及其后果。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "kind", "summary"],
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "kind": {
            "enum": [
              "search",
              "fetch",
              "fetch_failed",
              "extract",
              "claim_added",
              "claim_revised",
              "claim_dropped",
              "gap_declared",
              "section_written",
              "validate"
            ]
          },
          "summary": { "type": "string", "minLength": 1 },
          "target": {
            "type": "string",
            "description": "URL、source_id、claim_id 或章节锚点"
          },
          "source_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^src-" }
          },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^e-" }
          },
          "claim_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^c-" }
          },
          "outcome": {
            "enum": ["ok", "partial", "blocked", "superseded"]
          },
          "note": { "type": "string" }
        }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "citation_closure_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "citation_support_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "subquestion_completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
