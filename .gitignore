# 忽略规则
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 本地环境
.env
.env.*
!.env.example

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 运行产物
*.log
models/
checkpoints/
tmp/

# 研究留档中的原始快照（体积大，不入库）
research/**/raw/
research/**/notes/raw/

# 评测临时输出
evals/reports/tmp/
research/*/_bak_*.csv

# LaTeX 中间产物（PDF 与 .tex 源要入库，中间文件不要）
research/**/latex/*.aux
research/**/latex/*.log
research/**/latex/*.out
research/**/latex/*.toc
research/**/latex/*.synctex.gz

# 论文页面的 PNG 渲染（notes/pages/）：由 notes/render_pages.py 从 PDF 生成，
# 目的是人眼检查版面。它是 PDF 的派生物，体积 2.5MB，不入库。
research/*/notes/pages/
